# .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.

# privacy-genie-doc 주소(질문 임베딩, 문서 청크)
PRIVACY_GENIE_DOC_URL=http://privacy-genie-doc:8000

# 개발·테스트 DB. 비밀번호는 DB 컨테이너를 만들 때 정한 값을 넣는다.
DATABASE_PASSWORD=
# 기본값과 다를 때만 넣는다.
# DATABASE_USERNAME=privacy_genie
# DATABASE_HOST=privacy-db
# DATABASE_PORT=5432

# LLM (README "LLM 호출" 참고)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=

# 하루 전체 질문 수 상한(LLM 비용 차단기)
# ANSWER_DAILY_LIMIT=500
