<% content_for :title, "답변" %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<main class="page">
  <% if @answer.in_progress? %>
    <%# Job이 상태를 바꿀 때마다 refresh를 받는다. 구독 전에 끝나 버린 경우를 위해 주기적으로도 다시 그린다. %>
    <%= turbo_stream_from @answer %>
    <div hidden data-controller="refresh" data-refresh-interval-value="5000"></div>
  <% end %>

  <section class="question card" aria-label="질문">
    <p class="eyebrow">질문</p>
    <p class="question-text"><%= @answer.question %></p>
    <% if @answer.masked_kinds.any? %>
      <p class="hint">개인정보로 보이는 부분(<%= @answer.masked_kinds.join(", ") %>)을 가리고 처리했습니다.</p>
    <% end %>
  </section>

  <div class="answer-layout">
    <section id="answer" class="answer card" aria-labelledby="answer-heading" tabindex="-1">
      <h2 id="answer-heading" class="eyebrow">답변</h2>
      <div aria-live="polite">
        <%= render "status", answer: @answer %>
      </div>
    </section>

    <% if @answer.citations.any? %>
      <aside class="citations" aria-label="근거 조문">
        <%= render "citations", answer: @answer %>
      </aside>
    <% end %>
  </div>

  <% if Rails.env.local? %>
    <%= render "dev_meta", answer: @answer %>
  <% end %>

  <p class="page-actions"><%= link_to "새 질문하기", root_path, class: "button" %></p>
</main>
